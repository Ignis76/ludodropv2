{
  "name": "ludodrop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4188",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:motion": "node scripts/check-showcase-motion.mjs && node scripts/check-opening-motion.mjs",
    "test:clearance": "node scripts/check-case-clearance.mjs && node scripts/check-collectible-clearance.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
